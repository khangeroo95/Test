<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\nlog-internal.log" >

  <!-- optional, add some variabeles
  https://github.com/nlog/NLog/wiki/Configuration-file#variables
  -->
  <variable name="Version" value="Unknown"/>

  <!-- 
  See https://github.com/nlog/nlog/wiki/Configuration-file 
  for information on customizing logging rules and outputs.
   -->
  <!-- <extensions> -->
  <!-- <add assembly="CommonSysMT"/> -->
  <!-- </extensions> -->

  <targets async="true">
    <!-- <target xsi:type="FallbackGroup" name="tcp_file" returnToFirstOnSuccess="true"> -->
    <!-- <target name="tcp" xsi:type="NLogViewerEx" address="tcp4://127.0.0.1:9999" encoding="utf-8" keepConnection="true" IncludeAllProperties="true" > -->
    <!-- <parameter name="CallSite" layout="${callsite}" /> -->
    <!-- <parameter name="Exceptions" layout="${exception:format=type,message,source,method:separator=;:maxInnerExceptionLevel=2:innerFormat=type,message,source,method:innerExceptionSeparator= -> }" /> -->
    <!-- <parameter name="Version" layout="${var:name=Version:default=Unknown}" /> -->
    <!-- </target> -->
    <target name="file" xsi:type="File"
        layout="${longdate} | ${level:uppercase=true} | ${callsite} |${message}"
        fileName="${basedir}/Logs/${processname}/${processname}-${date:format=yyyy-MM-dd}.txt"
        archiveFileName="${basedir}/Logs/${processname}/${processname}-${date:format=yyyy-MM-dd}.txt"
        encoding="utf-8"
        archiveEvery="Day"
        maxArchiveFiles="3650"
        archiveAboveSize="1048576"
        maxArchiveDays="365"
        keepFileOpen="true"
        openFileCacheTimeout="30"
        concurrentWrites="true"
        autoFlush="false"
        openFileFlushTimeout="1" />
    <!-- </target> -->
    <!--<target xsi:type="FallbackGroup" name="tcp_file_ErrorFatal" returnToFirstOnSuccess="true">
    </target>-->
    <!--<target name="console" xsi:type="Console" layout="${message}" />-->
  </targets>
  <rules>
    <!-- <logger name="*" levels="Info,Warn, Error, Fatal" writeTo="tcp_file" /> -->
    <logger name="*" levels="Info, Warn, Error, Fatal" writeTo="file" />
    <logger name="*" levels="Trace ,Debug, Info, Warn, Error, Fatal" writeTo="console" />
  </rules>
</nlog>
